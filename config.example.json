    "style": "",
    "format": "",
    "ready": "",
    "request": "",
    "steer": "",
    "handover": "",
    "search": "",
    "no_search": "",
    "more": "",
    "retry": "",
    "ping": "",
    "ping_system": ""
  },
  "tuning": {
    "instructions_always": "",
    "instructions_sep": "。",
    "steps": 4,
    "lines_per_turn": 5,
    "max_chars": 120,
    "emoji_keep": false,
    "how_max": 40,
    "feel_max": 20,
    "voice_max": 60,
