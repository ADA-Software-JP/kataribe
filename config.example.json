    "kaomoji_pattern": "[(（][^ぁ-んァ-ン一-龥]*[)）]",
    "symbol_pattern": "[\\^*_=+<>|/\\\\;:'\\\"`@#$%&\\[\\]{}ω´｀°ﾟ∀▽≧≦]+",
    "voice_words": "声|男|女|少年|少女|子ども|老|\\b(?:voice|male|female|man|woman|boy|girl|child|kid|elderly|old|young)\\b",
    "change_pattern": "^\\s*(?:/change|change(?=\\s*(?:[,.!?、。！？]|$))|チェンジ)(?:で|して|お願い|\\s*please)?(?:[、。,.!！？?\\s]+|$)",
    "preload": 3,
    "stock_low": 2,
    "lead_min": 1.0,
    "lead_factor": 2.0,
    "pause_default": 0.0,
    "seed_mode": "random",
    "seed_value": 0,
    "reverb_check": true,
    "reverb_db": -30.0,
    "reverb_max_redo": 4,
    "clip_keep_ms": 40,
    "clip_fade_ms": 12,
    "clip_threshold": 0.05,
    "clip_peak_db": -1.0,
    "check_sec_min": 0.08,
    "check_sec_max": 0.6,
    "check_min_speech": 0.4,
    "check_min_chars": 4,
    "max_redo": 2,
    "max_fails": 3,
    "asr_min_match": 0.5,
    "history_turns": 4,
    "lm_temperature": 0.9,
    "lm_max_tokens": 2000,
    "codex_idle_limit": 120,
    "claude_start_timeout": 180
  }
